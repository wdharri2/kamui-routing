#!/bin/bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
controllers=(gedo-obito harashin-obito)

for controller in "${controllers[@]}"; do
    bash -n "$controller"
    printf 'Bash syntax OK: %s\n' "$controller"
done

if command -v shellcheck >/dev/null 2>&1; then
    shellcheck "${controllers[@]}"
else
    printf '%s\n' 'ShellCheck skipped (not installed).'
fi
